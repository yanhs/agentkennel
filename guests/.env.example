# AgentKennel guests — settings. Copy to guests/.env (guests/install.sh does it once) and
# fill in. guests/.env is never committed and never goes into an image. A variable set in
# the environment of a command wins over this file. Check: python3 guests/guestctl.py doctor

# The domain for the guests' addresses (required):
#   sb-<guest>.<domain>      each guest's dashboard (password-protected AgentKennel)
#   sbx.<domain>             files guests hand out by link
#   <site>-<guest>.<domain>  sites guests publish from their sandbox
GUESTS_DOMAIN=

# Language of what guests and you read (the bot, invitations, alerts, the rules written
# for the guests' agents): en (default), or the code of a language file you add yourself,
# guests/locale/<code>.json (start one from the English template:
# python3 guests/scripts/export_locale.py en -o guests/locale/<code>.json).
GUESTS_LANG=en
# Where language files are (default: guests/locale/, not part of git).
#GUESTS_LOCALE_DIR=

# The shared guest bot: create it with @BotFather. Only the host's Telegram turnstile
# holds this token; each sandbox gets a pass of its own instead.
GUEST_BOT_TOKEN=

# Your Telegram user id: the owner of your own AgentKennel bot (the dashboard's Telegram
# page; the Guests wizard copies it from there). Invitations ("Masha wants access. Let her
# in?") and alerts come to you in THAT bot; the guest bot only records requests.
OWNER_TG_ID=

# This server's public IPv4 — DNS records point here. Empty: detected via api.ipify.org.
SERVER_IP=

# DNS: with a Cloudflare API token (permission Zone.DNS:Edit) every guest's name is created
# on demand (proxied A record). Without the token file, make a wildcard A record
# *.<domain> -> SERVER_IP yourself. The file holds only the token.
#CF_TOKEN_FILE=~/.cf_token
# The Cloudflare zone, when it is not GUESTS_DOMAIN itself (e.g. GUESTS_DOMAIN=guests.example.com)
#CF_ZONE=example.com

# How alerts reach you. Empty: your own AgentKennel bot (when its owner is OWNER_TG_ID),
# else a message from the guest bot to OWNER_TG_ID. Or any bash
# command; the text is "$1", e.g.:
#GUESTS_NOTIFY_CMD=curl -s -d chat_id=123 --data-urlencode text="$1" https://api.telegram.org/bot<token>/sendMessage

# The sandbox image. Empty: agentkennel-guest:<AgentKennel version>, built by guests/install.sh.
#GUEST_IMAGE=

# Which web server carries the guests' addresses (sb-<guest>.<domain>, Open, their sites,
# sbx.<domain>): nginx (with certbot) or caddy (AgentKennel's own, from install.sh, when it
# serves port 443; it gets the certificates itself, no sudo). Empty: the server decides —
# Caddy when AgentKennel's Caddy is on 443, else nginx. `guestctl.py doctor` says which.
#GUESTS_WEB=
# With Caddy: the shared-files server's port on 127.0.0.1 (default 8795), Caddy's admin API
# (default http://localhost:2019), seconds to wait for a new name's certificate (default 120).
#GUESTS_FILES_PORT=8795
#GUESTS_CADDY_ADMIN=http://localhost:2019
#GUESTS_CERT_WAIT=120
